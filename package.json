{
  "name": "rpgizer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev --port 3002",
    "dev:clean": "node scripts/run-dev-clean.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "test": "vitest run",
    "eval:game-master": "tsx src/modules/game-master-assistant/evals/run-game-master-interview-evals.ts",
    "eval:generate-adventure": "tsx src/modules/adventure-planner/evals/run-generate-adventure-evals.ts",
    "eval:adventure-content": "tsx src/modules/adventure-planner/evals/run-adventure-content-evals.ts",
    "eval:adventure-linking": "tsx src/modules/adventure-planner/evals/run-adventure-linking-evals.ts",
    "eval:adventure-xp": "tsx src/modules/adventure-planner/evals/run-adventure-xp-evals.ts",
    "eval:interview-output-artifact": "tsx src/modules/game-master-assistant/evals/run-interview-output-artifact-evals.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@next/env": "^16.2.9",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "openai": "^6.45.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
